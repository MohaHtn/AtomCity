<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.AtomCity" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Background of the splash screen -->
        <item name="windowSplashScreenBackground">@color/white</item>
        <!-- Icon to be shown in the center -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <!-- Theme to switch to after the splash screen -->
        <item name="postSplashScreenTheme">@style/Theme.AtomCity</item>
    </style>
</resources>
